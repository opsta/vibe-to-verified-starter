rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /questions/{questionId} {
      allow read: if true;

      // Text: trimmed (first and last char not whitespace) and 1..280 Unicode
      // code points. Rules regex is RE2, where "." matches one code point,
      // so this equals the client check [...trimmed].length. (size() counts
      // UTF-16 units, so it is not used.)
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["text", "authorId", "votes", "createdAt"])
        && request.resource.data.keys().hasAll(["text", "authorId", "votes", "createdAt"])
        && request.resource.data.text is string
        && request.resource.data.text.matches("^\\S((?s:.){0,278}\\S)?$")
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.votes == 0
        && request.resource.data.createdAt is number
        // Client clock must be within 5 minutes of server time, so nobody
        // can back-date a question to win the createdAt tie-break.
        && request.resource.data.createdAt >= request.time.toMillis() - 300000
        && request.resource.data.createdAt <= request.time.toMillis() + 300000;

      // Only an upvote: votes +1, nothing else changes, and the caller's
      // vote doc is created in the same atomic write.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["votes"])
        && request.resource.data.votes == resource.data.votes + 1
        && !exists(/databases/$(database)/documents/questions/$(questionId)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/questions/$(questionId)/votes/$(request.auth.uid));

      allow delete: if false;

      match /votes/{voteId} {
        // Create only (no update), one doc per user, id equals uid, empty body.
        allow create: if signedIn()
          && voteId == request.auth.uid
          && request.resource.data.keys().size() == 0
          && exists(/databases/$(database)/documents/questions/$(questionId))
          && getAfter(/databases/$(database)/documents/questions/$(questionId)).data.votes
             == get(/databases/$(database)/documents/questions/$(questionId)).data.votes + 1;
        allow read: if signedIn() && voteId == request.auth.uid;
      }
    }
  }
}
