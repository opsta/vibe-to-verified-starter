{
  "name": "vibe-to-verified-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "start": "node server.mjs",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "check": "node scripts/check.mjs",
    "check:core": "node scripts/check-core.mjs",
    "test:scripts": "node --test scripts",
    "verify:contract": "tsc --noEmit && vitest run && node scripts/check-core.mjs && node scripts/check-tests.mjs && node scripts/check.mjs",
    "test:rules:emu": "firebase emulators:exec --only firestore,auth --project demo-vtv \"npm run test:rules\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
